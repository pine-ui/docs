{
  "name": "pine-docs",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "docusaurus": "docusaurus",
    "assistant:corpus": "node assistant/build-corpus.mjs",
    "prestart": "npm run assistant:corpus",
    "prebuild": "npm run assistant:corpus",
    "test:assistant": "node --test assistant/*.test.mjs",
    "postbuild": "node assistant/check-links.mjs",
    "test:docs": "node --test assistant/*.test.mjs src/components/InteractiveExample/model.test.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,mjs,css}\" \"assistant/*.mjs\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,mjs,css}\" \"assistant/*.mjs\" \"*.js\""
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "github-slugger": "^1.5.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
