{
  "name": "pine-docs",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "docusaurus": "docusaurus",
    "assistant:corpus": "node assistant/build-corpus.mjs",
    "prestart": "npm run assistant:corpus",
    "prebuild": "npm run assistant:corpus",
    "test:assistant": "node --test assistant/*.test.mjs",
    "postbuild": "node assistant/check-links.mjs && node agent-tools/check-build.mjs",
    "test:docs": "node --test assistant/*.test.mjs src/components/InteractiveExample/model.test.mjs agent-tools/*.test.mjs",
    "test:agents": "node --test agent-tools/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "github-slugger": "^1.5.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
